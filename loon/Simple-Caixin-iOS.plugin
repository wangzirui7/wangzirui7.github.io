#!name=极简财新 · Loon iOS
#!desc=保留 Simple-Caixin 的去水印、去干扰元素、响应式排版、语音/评论开关，并适配财新 iOS App WebView。不会修改会员、正文授权或付费校验。
#!author=wangzirui7
#!homepage=https://github.com/wangzirui7/wangzirui7.github.io/tree/main/loon
#!system=iOS,iPadOS
#!loon_version=3.2.1(733)
#!tag=财新,阅读,去广告

[URL Rewrite]
# HAR 中确认的财新广告位接口；只拦广告请求，不处理正文/授权接口。
^https?:\/\/(?:gg|dolphin)\.caixin\.com\/s(?:\?|$) reject-200

[Script]
# 设置面板 -> Loon 持久化配置桥
http-request ^https?:\/\/(?:[^\/]+\.)?caixin\.com\/__simple_caixin_config(?:\?|$) script-path=https://raw.githubusercontent.com/wangzirui7/wangzirui7.github.io/main/loon/Simple-Caixin-Loon.js,tag=极简财新设置同步,enable=true

# 全站网页 + iOS App WebView；脚本内部仅处理 HTML、评论和语音接口，其余响应原样放行。
http-response ^https?:\/\/(?:[^\/]+\.)?caixin\.com\/.* script-path=https://raw.githubusercontent.com/wangzirui7/wangzirui7.github.io/main/loon/Simple-Caixin-Loon.js,requires-body=true,timeout=10,tag=极简财新,enable=true

[MITM]
hostname = *.caixin.com
